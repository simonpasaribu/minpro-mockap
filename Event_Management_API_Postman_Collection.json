        {
          "name": "POST Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"dimasaptr@gmail.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/auth/login",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Login to get JWT access token. Token is automatically saved to environment variable 'TOKEN'."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Extract TOKEN from response and save to environment variable",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.environment.set(\"TOKEN\", jsonData.data.token);",
                  "    console.log(\"Token saved to environment variable: TOKEN\");",
                  "    console.log(\"Token: \" + jsonData.data.token);",
                  "} else if (jsonData.token) {",
                  "    pm.environment.set(\"TOKEN\", jsonData.token);",
                  "    console.log(\"Token saved to environment variable: TOKEN\");",
                  "    console.log(\"Token: \" + jsonData.token);",
                  "} else {",
                  "    console.log(\"No token found in response. Response structure:\");",
                  "    console.log(JSON.stringify(jsonData));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST Validate Referral Code",
          "request": {
            "method": "POST",
